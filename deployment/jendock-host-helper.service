# Opt-in unit for the Jendock host helper. Review every path against
# /etc/jendock/host-helper.json before installing (docs/ingress-host-helper.md).
[Unit]
Description=Jendock host helper (Apache vhosts and certificates)
After=network.target apache2.service
Documentation=file:///opt/jendock-host-helper/docs/ingress-host-helper.md

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONPATH=/opt/jendock-host-helper/lib PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/jendock-host-helper/venv/bin/python -m backend.hosthelper --config /etc/jendock/host-helper.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

# The socket directory is created fresh for the service; group access only.
RuntimeDirectory=jendock-ingress
RuntimeDirectoryMode=0750
# Keep the directory across restarts: the worker container bind-mounts it, and a recreated
# directory would leave the worker pointing at the old, deleted one.
RuntimeDirectoryPreserve=yes

# Hardening: root is needed to write Apache's include directory and run apachectl, nothing more.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/apache2/jendock-managed /etc/jendock/certs /var/lib/jendock/acme-webroot
# Apache's pid file and logs are touched by apachectl graceful.
ReadWritePaths=/run/apache2 /var/log/apache2
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# The helper listens on its Unix socket only, but `apachectl configtest` opens the configured
# Listen sockets (IPv4/IPv6) to check them, so those families must be allowed for its children.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
