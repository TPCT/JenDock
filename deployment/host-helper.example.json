{
  "socket_path": "/run/jendock-ingress/host.sock",
  "socket_mode": "0660",
  "socket_group": "jendock-ingress",
  "allowed_uids": [10001],
  "vhost_dir": "/etc/apache2/jendock-managed",
  "cert_dir": "/etc/jendock/certs",
  "webroot_dir": "/var/lib/jendock/acme-webroot",
  "apachectl": ["/usr/sbin/apachectl"],
  "allowed_hostname_suffixes": ["example.com"],
  "allowed_upstream_ports": [[20000, 29999]],
  "discovery_dirs": ["/etc/apache2/sites-enabled"],
  "allow_wildcards": false,
  "max_vhosts": 200,
  "command_timeout_seconds": 30
}
