[Unit]
Description=Deploy Monitor restricted ingress host helper
After=network.target apache2.service docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/docker-engine/projects/deploy-monitor
ExecStart=/opt/docker-engine/projects/deploy-monitor/.venv/bin/python /opt/docker-engine/projects/deploy-monitor/ingress_host_daemon.py --config /etc/deploy-monitor/ingress-host.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=deploy-monitor-ingress
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=no
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/etc/deploy-monitor /etc/apache2/deploy-monitor /var/lib/deploy-monitor /run/deploy-monitor-ingress
TimeoutStopSec=90
KillMode=control-group

[Install]
WantedBy=multi-user.target
