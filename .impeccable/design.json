  "narrative": {
    "northStar": "The Project Workspace",
    "overview": "The console is a restrained English operational workspace. White navigation and white content surfaces sit on a cool neutral canvas; indigo identifies deliberate actions and the current location. Fine borders, compact typography and generous space between groups organize dense technical evidence without turning the console into a decorative dashboard.\n\nThis is a code-led system extracted from the local functional redesign, not an approved visual comp or proof of deployment. The cascade loads `web/style.css` before `web/product.css`; the latter owns the current world. `web/index.html`, `web/app.js`, `web/controls.js` and `web/terminal.js` supply the implemented component and interaction evidence. Direction provenance is FORM `710ac72e`, grounded direction 4. The prior Arabic/teal visual world is superseded by the authorized replacement.",
    "keyCharacteristics": [
      "English LTR interface with readable technical identifiers.",
      "White sidebar, cool neutral canvas and flat bordered surfaces.",
      "Indigo actions and selection; explicit text alongside status colors.",
      "Responsive catalog, project workspace and contextual execution evidence.",
      "SVG line icons and a distinct dark interactive terminal."
    ],
    "rules": [
      {
        "name": "Evidence Color",
        "body": "Every status color accompanies a readable state label; a running service and a verified deployment remain different claims.",
        "section": "colors"
      },
      {
        "name": "Identity Before Metadata",
        "body": "Project and task names carry the strongest type within their group; repository, branch, timestamps and hashes support that identity.",
        "section": "typography"
      },
      {
        "name": "Flat Workspace",
        "body": "Keep routine content flat; reserve elevation for content temporarily layered above the workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the white sidebar, cool canvas and indigo action hierarchy.",
      "**Do** pair status colors with state text and relevant observation timestamps.",
      "**Do** retain project identity and source context through service and run views.",
      "**Do** enlarge supporting evidence on mobile and keep forms within the viewport.",
      "**Do** preserve visible labels, focus indicators and recoverable inline errors."
    ],
    "donts": [
      "**Don't** restore the superseded Arabic/teal identity as the default console world.",
      "**Don't** use a healthy-looking color to imply a deployment or health check that the evidence does not establish.",
      "**Don't** turn routine cards into floating layers or make the main navigation a content modal.",
      "**Don't** replace SVG interface icons with decorative glyphs.",
      "**Don't** present this local design preview as deployment or production acceptance."
    ]
  }
}
