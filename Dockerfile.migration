FROM python:3.13-alpine@sha256:2d9aefe2fef018a7eb2c13064c89c71929800fd2e5dccdbf52ea5da5bb8d929a
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apk add --no-cache php85 php85-phar php85-mbstring php85-openssl php85-tokenizer composer \
    && pip install --no-cache-dir 'psycopg[binary]==3.3.6'
COPY migration-parser/composer.json migration-parser/composer.lock /app/migration-parser/
RUN cd /app/migration-parser && COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --no-plugins --no-scripts --no-interaction --prefer-dist
COPY migration-parser/parse.php /app/migration-parser/
COPY migration_plan.py migration_laravel.py migration_postgres.py migration_laravel_postgres.py migration_protocol.py migration_helper_entry.py ./
USER 65534:65534
ENTRYPOINT ["python", "/app/migration_helper_entry.py"]
