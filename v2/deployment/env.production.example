# Copy to `.env` next to compose.yml (chmod 0640). No secrets belong in this file.
# See docs/deployment.md for what each value means and how to find it on the host.

# The public https origin of v2 (a DIFFERENT name from v1's monitoring.shiftcodes.net).
PUBLIC_ORIGIN=https://deploy.shiftcodes.net

# Host path of the isolated Docker daemon's socket (mounted at /var/run/docker.sock in the
# worker) and that socket's numeric group id: `stat -c %g /run/docker-isolation.sock`.
DOCKER_SOCKET_PATH=/run/docker-isolation.sock
DOCKER_GID=999

# The docker CLI and docker-compose binary v1 runs with (read-only mounts into the worker).
DOCKER_BINARY_HOST_PATH=/opt/docker-engine/29.8.2/docker/docker
DOCKER_COMPOSE_HOST_PATH=/opt/docker-engine/tools/docker-compose

# Host directory with the compose files and --env-file files of the deployed projects, mounted
# read-only into the worker at the IDENTICAL path. Environments reference files below it.
COMPOSE_PROJECTS_DIR=/opt/docker-engine/projects

# Host directories owned by uid 10001, gid 10001, mode 0750.
WORKSPACES_HOST_DIR=/var/lib/shiftcodes-workspaces
BACKUP_HOST_DIR=/var/backups/shiftcodes

# Reverse proxies whose X-Forwarded-For is trusted: the compose network gateway through which
# the host Apache reaches the published port (`docker network inspect shiftcodes-v2_default`).
TRUSTED_PROXIES=172.18.0.1

# Extra Host header values accepted at /mcp (the public name is accepted automatically). Apache
# forwards the original Host (ProxyPreserveHost On), so this normally stays empty.
MCP_ALLOWED_HOSTS=

# Image of the database inspector's helper containers (build: docker compose --profile tools
# build inspector). Only set this to use another name or tag.
INSPECTOR_IMAGE=shiftcodes-v2-inspector:latest

# Scheduled daily backups into BACKUP_HOST_DIR (never include the secret key).
BACKUP_ENABLED=false
BACKUP_KEEP=7
BACKUP_HOUR_UTC=3

# Commit status reporting to GitHub needs the environment secret GITHUB_STATUS_TOKEN.
GITHUB_STATUS_ENABLED=false
