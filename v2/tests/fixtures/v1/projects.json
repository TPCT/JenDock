{
  "aic-website": {
    "repository": "TPCT/aicconsultation.com",
    "repository_id": 1217712774,
    "branch": "development",
    "enabled": true,
    "reason": "Pushes trigger automatic build, isolated checks and deployment. Runtime failures restore the previous images.",
    "image_prefixes": [
      "aic-website-"
    ],
    "label": "aicconsultation.com",
    "container_prefixes": [
      "aic-website-"
    ],
    "recipe": {
      "compose_project": "aic",
      "env_file": "/opt/docker-engine/projects/aic/ports.env",
      "compose_files": [
        "/opt/docker-engine/projects/aic/compose.yml",
        "/opt/docker-engine/projects/aic/academy.yml",
        "/opt/docker-engine/projects/aic/sys.yml",
        "/opt/docker-engine/projects/aic/ops.yml"
      ],
      "services": [
        "website-api",
        "website-frontend",
        "website-reverb",
        "website-notifications"
      ],
      "images": [
        {
          "name": "aic-website-backend",
          "env_key": "AIC_WEBSITE_BACKEND_IMAGE",
          "target": null,
          "dockerfile": "backend/Dockerfile",
          "context": "backend",
          "env_mode": "image"
        },
        {
          "name": "aic-website-frontend",
          "env_key": "AIC_WEBSITE_FRONTEND_IMAGE",
          "target": "runner",
          "dockerfile": "frontend/Dockerfile",
          "context": "frontend",
          "env_mode": "image",
          "build_args": {
            "NEXT_PUBLIC_SITE_URL": "https://aicconsultation.com",
            "NEXT_PUBLIC_CMS_API_URL": "https://api.aicconsultation.com"
          }
        },
        {
          "name": "aic-website-reverb",
          "env_key": "AIC_WEBSITE_REVERB_IMAGE",
          "target": null,
          "dockerfile": "reverb/Dockerfile",
          "context": "reverb",
          "env_mode": "image"
        }
      ],
      "tests": [
        {
          "image": "aic-website-backend",
          "environment": {
            "DATABASE_URL": "sqlite:///:memory:",
            "JWT_SECRET": "isolated-build-check-no-production-secret",
            "MEDIA_ROOT": "/tmp/media"
          },
          "command": [
            "python",
            "-c",
            "from app.main import app; schema=app.openapi(); assert schema['paths']; assert any('health' in p for p in schema['paths'])"
          ]
        },
        {
          "image": "aic-website-reverb",
          "environment": {
            "APP_ENV": "testing",
            "APP_KEY": "base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
            "CACHE_STORE": "array",
            "CACHE_DRIVER": "array",
            "SESSION_DRIVER": "array",
            "QUEUE_CONNECTION": "sync",
            "MAIL_MAILER": "array",
            "DB_CONNECTION": "sqlite",
            "DB_DATABASE": ":memory:"
          },
          "tmpfs": [
            "/app/storage:uid=65534,gid=65534,size=128m",
            "/app/bootstrap/cache:uid=65534,gid=65534,size=16m"
          ],
          "command": [
            "sh",
            "-c",
            "mkdir -p storage/framework/cache/data storage/framework/views storage/framework/sessions storage/logs && find app -name '*.php' -print0 | xargs -0 -n1 php -l >/dev/null && php artisan route:list --json >/dev/null"
          ]
        }
      ],
      "http_checks": [
        {
          "url": "https://aicconsultation.com/",
          "statuses": [
            200
          ]
        }
      ]
    }
  },
