FROM python:3.13-alpine@sha256:2d9aefe2fef018a7eb2c13064c89c71929800fd2e5dccdbf52ea5da5bb8d929a
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir cryptography==48.0.1 'psycopg[binary]==3.3.6'
COPY database_postgres.py database_inspector_entry.py ./
USER 65534:65534
ENTRYPOINT ["python", "/app/database_inspector_entry.py"]
