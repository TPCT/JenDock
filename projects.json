  "captcha": {
    "repository": "TPCT/captcha.shiftcodes.net",
    "repository_id": 1411719795,
    "branch": "main",
    "enabled": true,
    "reason": "اختبار الصورة داخليًا: صحة الخدمة، تطابق الاستخراج، التزامن وحدود المدخلات. لا تُرسل طلبات لمزوّد الخدمة.",
    "recipe": {
      "compose_project": "dsl",
      "env_file": "/opt/docker-engine/projects/dsl/ports.env",
      "compose_files": [
        "/opt/docker-engine/projects/dsl/compose.yml"
      ],
      "services": [
        "captcha"
      ],
      "images": [
        {
          "name": "dsl-captcha",
          "dockerfile": "Dockerfile",
          "target": "runtime",
          "env_key": "CAPTCHA_IMAGE"
        },
        {
          "name": "deploy-test-captcha",
          "dockerfile": "Dockerfile",
          "target": "test",
          "deploy": false
        }
      ],
      "tests": [
        {
          "image": "deploy-test-captcha",
          "command": [
            "python",
            "tests/check_container.py"
          ]
        }
      ],
      "http_checks": [
        {
          "url": "https://captcha.shiftcodes.net/health",
          "statuses": [
            200
          ]
        }
      ]
    },
    "image_prefixes": [
      "dsl-captcha:"
    ]
  },
